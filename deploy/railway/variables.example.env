# Required by the programming-focused-app Railway service.
# Paste these keys into Railway -> programming-focused-app -> Variables -> RAW Editor.
# Replace both JWT placeholders with different random values. Never commit real secrets.

NODE_ENV=production
JWT_ACCESS_SECRET=<generate-a-long-random-secret>
JWT_REFRESH_SECRET=<generate-a-different-long-random-secret>
SESSION_HOURS=2

# REQUIRED: use this exact plain-text hostname. It requires a second service
# named exactly "rethinkdb" in the same Railway project and environment.
RETHINKDB_SERVERS=rethinkdb.railway.internal:28015
RETHINKDB_DB=programming_focused
RETHINKDB_USER=admin
RETHINKDB_TIMEOUT=20
RETHINKDB_INIT_MAX_ATTEMPTS=60
RETHINKDB_INIT_RETRY_MS=2000

# Generate a public domain for programming-focused-app and insert it here.
CORS_ORIGIN=https://<your-generated-railway-domain>
